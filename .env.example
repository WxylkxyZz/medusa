# Local-only environment placeholders. Do not put real credentials here.
DATABASE_URL=postgres://medusa:local-only-password@localhost:55432/medusa?sslmode=disable
REDIS_URL=redis://localhost:56379
MEDUSA_FF_CACHING=true
JWT_SECRET=replace-with-a-local-random-secret
COOKIE_SECRET=replace-with-a-different-local-random-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000
LOCAL_HTTP_ADMIN=true
MEDUSA_WORKER_MODE=server

# Optional external providers; leave empty until their isolated environments are ready.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
R2_ENDPOINT=
R2_REGION=auto
R2_FILE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILE_BUCKET=
R2_BACKUP_BUCKET=
