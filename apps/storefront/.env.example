# Public Storefront values for local development.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=replace-after-local-admin-setup
NEXT_PUBLIC_DEFAULT_REGION=us
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Docker Compose injects this server-only override. Leave unset for host development.
# MEDUSA_BACKEND_URL_INTERNAL=http://backend-server:9000

# Required when the publishable key is linked to multiple sales channels.
# Choose one of the channels authorized by that key.
# MEDUSA_SALES_CHANNEL_ID=sc_replace_with_storefront_channel
