{
  "name": "@b2c/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa v2 backend for the B2C storefront",
  "scripts": {
    "build": "medusa build && node scripts/link-admin-public.cjs",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate",
    "bootstrap:local": "medusa exec ./src/scripts/bootstrap-local.ts",
    "test": "npm run test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.23.0",
    "@medusajs/admin-shared": "2.23.0",
    "@medusajs/cli": "2.23.0",
    "@medusajs/dashboard": "2.23.0",
    "@medusajs/framework": "2.23.0",
    "@medusajs/medusa": "2.23.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.37",
    "@medusajs/eslint-plugin": "2.23.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "jest": "^30.2.0",
    "ts-node": "10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
